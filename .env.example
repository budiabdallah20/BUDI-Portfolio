# BUDI Portfolio - environment template
# Copy to .env for local development:
#   cp .env.example .env
# On Vercel: add these in Project -> Settings -> Environment Variables -> Production.
# Never commit a real .env or real secrets.

# 1) Public canonical URL
# Local:    http://localhost:3000  (use https://localhost:8443 with npm run dev:https)
# Vercel:   https://budi-portfolio-dev.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# 2) Supabase (Project Settings -> API)
# NEXT_PUBLIC_* values are safe to expose in the browser; RLS protects the data.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace_with_your_anon_key
# Server-only. NEVER prefix this with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=replace_with_your_service_role_key

# 3) Admin gate
# Dashboard PIN: exactly 4 digits. Replace this example before use.
ADMIN_API_SECRET=4821
# Footer admin entry: a separate, strong password (not the dashboard PIN).
ADMIN_ENTRY_PASSWORD=replace_with_a_long_random_password

# 4) Web Push (VAPID)
# Generate a pair with:
#   node -e "console.log(require('web-push').generateVAPIDKeys())"
NEXT_PUBLIC_VAPID_PUBLIC_KEY=replace_with_your_vapid_public_key
# Server-only. Never commit or expose this key.
VAPID_PRIVATE_KEY=replace_with_your_vapid_private_key
VAPID_SUBJECT=https://budi-portfolio-dev.vercel.app

# 5) Optional
# Local "Punch it" deploy only. Leave unset to use the machine's git credentials.
# GIT_TOKEN=
# Google Search Console verification token.
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Do NOT add NODE_ENV, PORT, or VERCEL_* manually.
# Vercel sets those itself; overriding them can break the deployment.

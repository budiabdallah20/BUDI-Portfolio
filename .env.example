# Public site URL (used for metadata / sitemap)
NEXT_PUBLIC_SITE_URL=

# ── Supabase (Project Settings → API) ─────────────────────
────────
# 1) Project URL — safe to expose (NEXT_PUBLIC_*)
NEXT_PUBLIC_SUPABASE_URL=https://xyzcompany.supabase.co
# 2) anon public key — safe to expose, RLS protects the data
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...
# 3) service_role key — SECRET! server only, NEVER expose, NEVER commit.
#    Used only inside /api/admin/* route handlers.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# ── Admin gate ────────────────────────────────────────────────────
# 4) Dashboard PIN — exactly 4 digits (the /admin login is a PIN pad).
#    A short PIN is SAFE here because the server locks out brute-force
#    (8 bad tries → 15min lock + global bucket, spoof-proof IP keying).
#    Pick a random one, NEVER reuse 2909, NEVER commit the real .env.
#    After changing it: restart dev server + update hosting env vars.
ADMIN_API_SECRET=

# ── Push notifications (Web Push / VAPID) ──────────────────────────
# Public key — safe to expose (used by the browser to subscribe).
NEXT_PUBLIC_VAPID_PUBLIC_KEY=BHKwZpk5J8E0vpVpdB_Zmlw2YI6VMUcFLUkb7F746wFmhzUdui1pbEHIiQRxG6PfX8V-kD25XeM-mqgWD6bC6xw
# Private key — SECRET! server only, NEVER expose, NEVER commit.
VAPID_PRIVATE_KEY=AQEDVIagm_NfyhGwkRoa8XXiqJ4ogl5Eq6XpMpYdAPk
# Contact shown to push services (any https URL or mailto:).
VAPID_SUBJECT=https://budi-portfolio.vercel.app

# ── "Punch it" deploy button (optional but recommended) ───────
# GitHub token so the dashboard can push WITHOUT relying on the host's
# stored git credentials. Create at: GitHub → Settings → Developer
# settings → Personal access tokens → Fine-grained (this repo, Contents:
# Read+Write). Used for one push command only, never logged, never stored.
# If empty, the server falls back to its own git credentials.
GIT_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
 
# Footer admin entry gate — separate password from the dashboard PIN (ADMIN_API_SECRET).
ADMIN_ENTRY_PASSWORD=1907 

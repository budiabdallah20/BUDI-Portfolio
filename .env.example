# Public site URL (used for metadata / sitemap)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Supabase (Project Settings → API) ─────────────────────────────
# 1) Project URL — safe to expose (NEXT_PUBLIC_*)
NEXT_PUBLIC_SUPABASE_URL=https://xyzcompany.supabase.co
# 2) anon public key — safe to expose, RLS protects the data
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...
# 3) service_role key — SECRET! server only, NEVER expose, NEVER commit.
#    Used only inside /api/admin/* route handlers.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# ── Admin gate ────────────────────────────────────────────────────
# 4) Strong password for dashboard → API writes (min 16 chars).
#    You type it once in /admin to unlock saving to Supabase.
ADMIN_API_SECRET=change-me-to-a-long-random-secret
